<UserControl x:Class="UsageNotch.Controls.StatsDashboard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:UsageNotch.Controls">
 <UserControl.Resources>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="#EDF1FA"/><Setter Property="Padding" Value="10,8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
    <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#344157"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#E4E9F5"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#1C2230" BorderBrush="#374053" BorderThickness="1" CornerRadius="9" Padding="10,11"><TextBlock Text="⌄" Foreground="#A5B5CB" HorizontalAlignment="Right"/></Border></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="11,0,25,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
     <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
      <Border Background="#1C2230" BorderBrush="#374053" BorderThickness="1" CornerRadius="9" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="260"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border>
     </Popup>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,0,22,12">
  <StackPanel>
   <TextBlock Text="YOUR USAGE, OVER TIME" Foreground="#85DFC2" FontSize="10" FontWeight="SemiBold" Margin="0,4,0,8"/>
   <TextBlock Text="A little more perspective." Foreground="#F6F7FC" FontSize="25" FontWeight="SemiBold"/>
   <TextBlock Text="Real observations. Clear limits. Room to plan." Foreground="#A5AABD" Margin="0,7,0,16"/>
   <Grid Margin="0,0,0,16">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
    <ComboBox x:Name="ProviderPicker" SelectionChanged="ProviderChanged" Margin="0,0,8,0" Padding="8" AutomationProperties.Name="History provider"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
    <ComboBox x:Name="WindowPicker" Grid.Column="1" SelectionChanged="SelectionChanged" Margin="0,0,8,0" Padding="8" AutomationProperties.Name="Limit window"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
    <ComboBox x:Name="RangePicker" Grid.Column="2" SelectedIndex="0" SelectionChanged="SelectionChanged" Padding="8" AutomationProperties.Name="History range">
     <ComboBoxItem Content="24 hours"/><ComboBoxItem Content="7 days"/><ComboBoxItem Content="30 days"/>
    </ComboBox>
   </Grid>
   <Border CornerRadius="18" BorderBrush="#28364C" BorderThickness="1" Padding="20" Margin="0,0,0,14">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1B293A"/><GradientStop Color="#121820" Offset="1"/></LinearGradientBrush></Border.Background>
    <StackPanel>
     <DockPanel><TextBlock Text="OBSERVED USAGE" Foreground="#A5B5CB" FontSize="10"/><TextBlock x:Name="StatusLabel" Foreground="#85DFC2" HorizontalAlignment="Right" FontSize="11"/></DockPanel>
     <TextBlock x:Name="UsageLabel" Text="Waiting for a reading" Foreground="#F6F7FC" FontSize="32" FontWeight="SemiBold" Margin="0,10,0,0"/>
     <TextBlock x:Name="ObservationLabel" Foreground="#A5AABD" FontSize="11" Margin="0,5,0,16" TextWrapping="Wrap"/>
     <local:UsageChart x:Name="Chart" Height="155" AutomationProperties.Name="Observed usage percentage over local time"/>
     <TextBlock Text="Usage used (%) · local time · gaps mean no observations" Foreground="#939FB5" FontSize="10" Margin="0,8,0,0"/>
    </StackPanel>
   </Border>
   <Grid Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
   <Border Background="#171922" BorderBrush="#2B3042" BorderThickness="1" CornerRadius="15" Padding="16" Margin="0,0,10,0"><StackPanel>
    <TextBlock Text="NEXT RESET" Foreground="#A5AABD" FontSize="10"/>
    <TextBlock x:Name="ResetLabel" Foreground="#F5F6FB" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,5" TextWrapping="Wrap"/>
    <TextBlock x:Name="ResetDate" Foreground="#A5AABD" FontSize="11" TextWrapping="Wrap"/>
   </StackPanel></Border>
   <Border Grid.Column="1" Background="#1D1B2D" BorderBrush="#3A3454" BorderThickness="1" CornerRadius="15" Padding="16"><StackPanel>
    <TextBlock Text="USAGE-PACE FORECAST · ESTIMATE" Foreground="#C6B3F1" FontSize="10" FontWeight="SemiBold"/>
    <TextBlock x:Name="ForecastLabel" Foreground="#F5F6FB" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,7" TextWrapping="Wrap"/>
    <TextBlock x:Name="ForecastDetail" Foreground="#B3AEC6" FontSize="12" TextWrapping="Wrap"/>
   </StackPanel></Border>
   </Grid>
   <TextBlock x:Name="HistoryNote" Text="Private by design. Up to 30 days stored on this PC. History is collected only while UsageNotch runs; no backfill or invented data." Foreground="#8E95A9" FontSize="11" TextWrapping="Wrap"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
