                                        <CheckBox x:Name="AutoHideBox" Content="Tuck the dock off-screen when the mouse leaves" Style="{StaticResource Toggle}" />
                                        <Grid Margin="0,8,0,0"><TextBlock Text="Wait before tucking away" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="AutoHideValue" Style="{StaticResource SliderLabel}" HorizontalAlignment="Right"/></Grid>
                                        <Slider x:Name="AutoHideSlider" Minimum="150" Maximum="4000" TickFrequency="50" Margin="0,6,0,4"/>
