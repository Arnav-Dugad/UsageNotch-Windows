<Window x:Class="UsageNotch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:UsageNotch.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="UsageNotch · Stats &amp; Settings" Icon="Assets/UsageNotch.ico" Width="1180" Height="840" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource Ui.Background}" MinWidth="760" MinHeight="560" ShowInTaskbar="True"
        Foreground="{DynamicResource Ui.Text}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <CubicEase x:Key="FluidEase" EasingMode="EaseOut" />

        <!-- Glass: a translucent body over the ambient light, a specular rim and a soft top sheen. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Ui.Glass}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ui.Rim}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Ui.Text}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="Margin" Value="0,6,0,4" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Ui.Text}" />
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Ui.Muted}" />
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="6,14,0,8" />
        </Style>

        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Ui.Muted}" />
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SliderLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Ui.Accent}" />
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Ui.Text}" />
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,7" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Border x:Name="Track" Grid.Column="1" Width="44" Height="26" CornerRadius="13" Background="{DynamicResource Ui.Track}" BorderBrush="{DynamicResource Ui.Hairline}" BorderThickness="1">
                            <Ellipse x:Name="Thumb" Width="20" Height="20" Margin="2.5,0,0,0" HorizontalAlignment="Left" Fill="White">
                                <Ellipse.RenderTransform><TranslateTransform X="0" /></Ellipse.RenderTransform>
                                <Ellipse.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.35" /></Ellipse.Effect>
                            </Ellipse>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Ui.Live}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Ui.Live}" />
                            <Trigger.EnterActions><BeginStoryboard HandoffBehavior="SnapshotAndReplace"><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="RenderTransform.X" To="18" Duration="0:0:0.34">
                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.45"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard HandoffBehavior="SnapshotAndReplace"><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="RenderTransform.X" To="0" Duration="0:0:0.34">
                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.45"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.88" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Ui.Text}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Ui.Text}" />
            <Setter Property="Background" Value="{DynamicResource Ui.Inner}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ui.Hairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="TextBox">
                    <Border x:Name="FieldBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource Ui.Accent}" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FieldBorder" Property="Background" Value="{DynamicResource Ui.InnerHover}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PasswordField" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{DynamicResource Ui.Text}" /><Setter Property="CaretBrush" Value="{DynamicResource Ui.Text}" />
            <Setter Property="Background" Value="{DynamicResource Ui.Inner}" /><Setter Property="BorderBrush" Value="{DynamicResource Ui.Hairline}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" /><Setter Property="FontFamily" Value="{StaticResource UIFont}" /><Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="FieldBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource Ui.Accent}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <!-- Segments sit inside a glass capsule; the selected one is a raised drop of glass. -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Ui.Muted}" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="16,8" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="12.5" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="SegmentSurface" CornerRadius="999" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Margin="2" BorderThickness="1" BorderBrush="Transparent">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="SegmentSurface" Property="Background" Value="{DynamicResource Ui.Selected}" />
                        <Setter TargetName="SegmentSurface" Property="BorderBrush" Value="{DynamicResource Ui.Rim}" />
                        <Setter Property="Foreground" Value="{DynamicResource Ui.Text}" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SegmentSurface" Property="Opacity" Value="0.88" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="SegmentHost" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Ui.Inner}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ui.Hairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="2" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Ui.Text}" /><Setter Property="Background" Value="{DynamicResource Ui.Inner}" /><Setter Property="BorderBrush" Value="{DynamicResource Ui.Hairline}" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="16,9" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="12.5" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="999" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource Ui.InnerHover}" /></Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Trigger.EnterActions><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.96" Duration="0:0:0.08"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.96" Duration="0:0:0.08"/>
                        </Storyboard></BeginStoryboard></Trigger.EnterActions>
                        <Trigger.ExitActions><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.42"><DoubleAnimation.EasingFunction><ElasticEase Oscillations="1" Springiness="5" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.42"><DoubleAnimation.EasingFunction><ElasticEase Oscillations="1" Springiness="5" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard></BeginStoryboard></Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="{DynamicResource Ui.OnAccent}" /><Setter Property="Background" Value="{DynamicResource Ui.Accent}" /><Setter Property="BorderBrush" Value="{DynamicResource Ui.Rim}" />
        </Style>

        <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Width" Value="36"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
                <Grid Background="Transparent">
                    <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                           Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                            <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                <Border Background="{DynamicResource Ui.Live}" Height="5" CornerRadius="2.5" VerticalAlignment="Center"/>
                            </ControlTemplate></RepeatButton.Template>
                        </RepeatButton></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb Width="20" Height="20" Cursor="Hand">
                            <Thumb.Template><ControlTemplate TargetType="Thumb">
                                <Grid>
                                    <Ellipse x:Name="Halo" Fill="{DynamicResource Ui.Live}" Width="28" Height="28" Opacity="0"/>
                                    <Ellipse x:Name="Handle" Fill="White" Width="20" Height="20" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                                        <Ellipse.Effect><DropShadowEffect BlurRadius="7" ShadowDepth="1" Opacity="0.4"/></Ellipse.Effect>
                                    </Ellipse>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Halo" Property="Opacity" Value="0.25"/></Trigger>
                                    <Trigger Property="IsDragging" Value="True">
                                        <Setter TargetName="Halo" Property="Opacity" Value="0.35"/>
                                        <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Handle" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.18" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Handle" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.18" Duration="0:0:0.18"/>
                                        </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                        <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Handle" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.4"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Handle" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.4"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></Thumb.Template>
                        </Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                            <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                <Border Background="{DynamicResource Ui.Track}" Height="5" CornerRadius="2.5" VerticalAlignment="Center"/>
                            </ControlTemplate></RepeatButton.Template>
                        </RepeatButton></Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <!-- Expanders: a quiet header with a chevron that turns. -->
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource Ui.Text}"/>
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
                <StackPanel>
                    <ToggleButton x:Name="HeaderToggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Cursor="Hand" Focusable="True">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent" Padding="6,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Ui.Muted}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Margin="0,0,10,0">
                                        <TextBlock.RenderTransform><RotateTransform Angle="0"/></TextBlock.RenderTransform>
                                    </TextBlock>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="RenderTransform.Angle" To="90" Duration="0:0:0.22" EasingFunction="{StaticResource FluidEase}"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                                    <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="RenderTransform.Angle" To="0" Duration="0:0:0.22" EasingFunction="{StaticResource FluidEase}"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></ToggleButton.Template>
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" TextElement.FontWeight="SemiBold"/>
                    </ToggleButton>
                    <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="0,4,0,0"/>
                </StackPanel>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <!-- Settings sidebar: a glyph and a label; the selected row is a glass drop. -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Ui.Muted}"/>
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="SettingsNav"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Row" CornerRadius="14" Padding="12,9" Margin="0,1" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{TemplateBinding Foreground}"/>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Ui.Inner}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Ui.Selected}"/>
                        <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Ui.Rim}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Ui.Text}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="NavTab" TargetType="TabItem">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border/></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="NavTabs" TargetType="TabControl">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
                <Grid>
                    <StackPanel IsItemsHost="True" Visibility="Collapsed"/>
                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="PageScroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Padding" Value="6,0,26,8"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="SettingsRoot" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><ScaleTransform x:Name="SettingsScale" ScaleX="0.975" ScaleY="0.975" /></Grid.RenderTransform>
        <Border x:Name="WindowSurface" BorderBrush="{DynamicResource Ui.Hairline}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <controls:AmbientBackground x:Name="Ambient"/>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <Grid Grid.Row="0" Height="72" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="24,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="Assets/UsageNotch-logo.png" Width="34" Height="34" Stretch="Uniform" Margin="0,0,12,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="UsageNotch" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Ui.Text}" />
                                <TextBlock x:Name="VersionLine" Text="2.6" Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <ContentControl x:Name="TopTabsHost" Grid.Column="1" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                            <ContentControl x:Name="StatusHost" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Content="&#xE921;" ToolTip="Minimize" AutomationProperties.Name="Minimize" Style="{StaticResource ChromeButton}" Click="Minimize_Click"/>
                            <Button Content="&#xE922;" ToolTip="Maximize / restore" AutomationProperties.Name="Maximize or restore" Style="{StaticResource ChromeButton}" Click="Maximize_Click" Margin="2,0"/>
                            <Button Content="&#xE740;" ToolTip="Full screen (F11)" AutomationProperties.Name="Full screen" Style="{StaticResource ChromeButton}" Click="Fullscreen_Click" Margin="0,0,2,0"/>
                            <Button Content="&#xE8BB;" ToolTip="Close" AutomationProperties.Name="Close" Style="{StaticResource ChromeButton}" Click="Cancel_Click"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="SettingsNavHost" Style="{StaticResource Card}" Width="214" Margin="22,2,8,12" Padding="8" VerticalAlignment="Top" Visibility="Collapsed">
                            <StackPanel x:Name="SettingsNav">
                                <RadioButton Content="Dock" Tag="&#xE737;" Style="{StaticResource NavItem}" Click="Nav_Click" CommandParameter="2"/>
                                <RadioButton Content="Appearance" Tag="&#xE790;" Style="{StaticResource NavItem}" Click="Nav_Click" CommandParameter="3"/>
                                <RadioButton Content="Behaviour" Tag="&#xE713;" Style="{StaticResource NavItem}" Click="Nav_Click" CommandParameter="4"/>
                                <RadioButton Content="Alerts" Tag="&#xEA8F;" Style="{StaticResource NavItem}" Click="Nav_Click" CommandParameter="5"/>
                                <RadioButton Content="Providers &amp; accounts" Tag="&#xE77B;" Style="{StaticResource NavItem}" Click="Nav_Click" CommandParameter="6"/>
                                <RadioButton Content="Budgets" Tag="&#xE8C8;" Style="{StaticResource NavItem}" Click="Nav_Click" CommandParameter="7"/>
                                <RadioButton Content="Time" Tag="&#xE823;" Style="{StaticResource NavItem}" Click="Nav_Click" CommandParameter="8"/>
                                <RadioButton Content="Phone" Tag="&#xE8EA;" Style="{StaticResource NavItem}" Click="Nav_Click" CommandParameter="9"/>
                                <RadioButton Content="Data &amp; privacy" Tag="&#xE72E;" Style="{StaticResource NavItem}" Click="Nav_Click" CommandParameter="10"/>
                                <RadioButton Content="Updates" Tag="&#xE895;" Style="{StaticResource NavItem}" Click="Nav_Click" CommandParameter="11"/>
                            </StackPanel>
                        </Border>

                        <TabControl x:Name="SettingsTabs" Grid.Column="1" Style="{StaticResource NavTabs}" Background="Transparent" BorderThickness="0" SelectionChanged="SettingsTabs_SelectionChanged">

                            <TabItem Header="Overview" Style="{StaticResource NavTab}">
                                <controls:StatsDashboard x:Name="StatsView"/>
                            </TabItem>

                            <TabItem Header="History" Style="{StaticResource NavTab}">
                                <controls:HistoryView x:Name="HistoryPageView"/>
                            </TabItem>

                            <TabItem Header="Dock" Style="{StaticResource NavTab}">
                                <ScrollViewer Style="{StaticResource PageScroll}"><StackPanel MaxWidth="860" HorizontalAlignment="Left" Margin="6,0,0,0">
                                    <TextBlock Text="Make it yours" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="Choose the information you want at a glance. Changes preview live on the dock." Style="{StaticResource SecondaryText}" Margin="0,0,0,16"/>
                                    <Border Style="{StaticResource Card}" Padding="10"><controls:SettingsPreview x:Name="DockTextPreview" Scene="Text"/></Border>
                                    <TextBlock Text="RINGS" Style="{StaticResource GroupLabel}"/>
                                    <Border Style="{StaticResource Card}"><StackPanel>
                                        <TextBlock Text="What each ring shows" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="Show one limit, or keep session and weekly limits in separate rings." Style="{StaticResource SecondaryText}" Margin="0,5,0,12"/>
                                        <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
