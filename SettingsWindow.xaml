                                    <Border Style="{StaticResource Card}"><StackPanel>
                                        <Grid><TextBlock Text="Dock size" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="ScaleValue" Style="{StaticResource SliderLabel}" HorizontalAlignment="Right"/></Grid>
                                        <Slider x:Name="ScaleSlider" Minimum="0.75" Maximum="1.5" TickFrequency="0.05" Margin="0,6,0,16"/>
                                        <Grid><TextBlock Text="Space between providers" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="SpacingValue" Style="{StaticResource SliderLabel}" HorizontalAlignment="Right"/></Grid>
                                        <Slider x:Name="SpacingSlider" Minimum="4" Maximum="48" TickFrequency="2" Margin="0,6,0,16"/>
                                        <Grid><TextBlock Text="Position along screen edge" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="PositionValue" Style="{StaticResource SliderLabel}" HorizontalAlignment="Right"/></Grid>
                                        <Slider x:Name="PositionSlider" Minimum="0" Maximum="1" TickFrequency="0.05" Margin="0,6,0,16"/>
                                        <Grid><TextBlock Text="Dock opacity" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="OpacityValue" Style="{StaticResource SliderLabel}" HorizontalAlignment="Right"/></Grid>
                                        <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1" TickFrequency="0.05" Margin="0,6,0,4"/>
                                    </StackPanel></Border>

                                    <TextBlock Text="DOCK SURFACE" Style="{StaticResource GroupLabel}"/>
                                    <Border Style="{StaticResource Card}"><StackPanel>
                                        <TextBlock Text="Dock and detail-card colour" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                        <WrapPanel>
                                            <Button Content="Ink" Tag="#0B0B0E" Click="ColorPreset_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,7,7"/>
                                            <Button Content="True black" Tag="#000000" Click="ColorPreset_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,7,7"/>
                                            <Button Content="Graphite" Tag="#1C1C22" Click="ColorPreset_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,7,7"/>
                                            <Button Content="Snow" Tag="#FFFFFF" Click="ColorPreset_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,7,7"/>
                                            <Button Content="Choose colour…" Click="CustomColor_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,7,7"/>
                                            <Border x:Name="ColorSwatch" Width="34" Height="34" CornerRadius="17" BorderBrush="{DynamicResource Ui.Rim}" BorderThickness="1" Margin="4,0,0,7"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="ColorLabel" Style="{StaticResource SecondaryText}" Margin="0,6,0,10"/>
                                        <CheckBox x:Name="GlassBox" Content="Glass sheen on the dock surface" Style="{StaticResource Toggle}"/>
                                        <CheckBox x:Name="FloatingBox" Content="Free-floating dock (drag to position)" Style="{StaticResource Toggle}"/>
                                        <TextBlock Text="Drag any icon or empty dock space to move it. Drop it near a screen edge and it snaps back into the notch shape." Style="{StaticResource SecondaryText}" Margin="0,2,0,10"/>
                                        <CheckBox x:Name="SnapBox" Content="Snap to the screen edge when dropped nearby" Style="{StaticResource Toggle}"/>
                                        <CheckBox x:Name="PredictiveBox" Content="Anticipate drag direction" Style="{StaticResource Toggle}"/>
                                        <TextBlock Text="The shape gently reaches toward your next edge. Icons stay upright; the layout changes when you release. Reduced motion turns this preview off." Style="{StaticResource SecondaryText}" Margin="0,2,0,8"/>
                                        <TextBlock Text="Screen edge" Style="{StaticResource SectionTitle}" Margin="0,12,0,8"/>
                                        <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="EdgeRight" Content="Right" GroupName="Edge" Style="{StaticResource Segment}" />
                                                <RadioButton x:Name="EdgeLeft" Content="Left" GroupName="Edge" Style="{StaticResource Segment}" />
                                                <RadioButton x:Name="EdgeTop" Content="Top" GroupName="Edge" Style="{StaticResource Segment}" />
                                            </StackPanel>
                                        </Border>
                                        <Button Content="Restore default appearance" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="RestoreAppearance_Click"/>
                                    </StackPanel></Border>
                                </StackPanel></ScrollViewer>
                            </TabItem>

                            <TabItem Header="Behaviour" Style="{StaticResource NavTab}">
                                <ScrollViewer Style="{StaticResource PageScroll}"><StackPanel MaxWidth="860" HorizontalAlignment="Left" Margin="6,0,0,0">
                                    <TextBlock Text="How it behaves" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="Where the dock lives, how it hides and how often it checks." Style="{StaticResource SecondaryText}" Margin="0,0,0,16"/>
                                    <Border Style="{StaticResource Card}" Padding="10"><controls:SettingsPreview x:Name="BehaviorPreview" Scene="Behavior"/></Border>
                                    <TextBlock Text="WINDOW" Style="{StaticResource GroupLabel}"/>
                                    <Border Style="{StaticResource Card}"><StackPanel>
                                        <CheckBox x:Name="AlwaysVisibleBox" Content="Keep above other windows" Style="{StaticResource Toggle}" />
                                        <CheckBox x:Name="TrayBox" Content="Show system tray icon" Style="{StaticResource Toggle}" />
                                        <CheckBox x:Name="StartupBox" Content="Start UsageNotch when I sign in" Style="{StaticResource Toggle}" />
                                        <CheckBox x:Name="ClickThroughBox" Content="Click through the dock (ignore the mouse entirely)" Style="{StaticResource Toggle}" />
                                        <TextBlock Text="With click-through on, the dock becomes purely decorative. Turn it back off from the tray icon." Style="{StaticResource SecondaryText}" Margin="0,2,0,0"/>
                                    </StackPanel></Border>

                                    <TextBlock Text="HIDE UNTIL HOVER" Style="{StaticResource GroupLabel}"/>
