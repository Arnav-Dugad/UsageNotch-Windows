                                        <CheckBox x:Name="ExpandedResetBox" Content="Reset times in the expanded card" Style="{StaticResource Toggle}"/>
                                    </StackPanel></Border>
                                    <Border Style="{StaticResource Card}"><Expander Header="Custom provider names"><StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="Used on the dock and synced with your phone. Leave blank for the original name; turn on Provider names above." Style="{StaticResource SecondaryText}" Margin="0,0,0,10"/>
                                        <TextBlock Text="Claude" Style="{StaticResource SecondaryText}"/><TextBox x:Name="ClaudeLabelField" MaxLength="18" Style="{StaticResource Field}" Margin="0,4,0,10" AutomationProperties.Name="Claude dock label"/>
                                        <TextBlock Text="Codex" Style="{StaticResource SecondaryText}"/><TextBox x:Name="CodexLabelField" MaxLength="18" Style="{StaticResource Field}" Margin="0,4,0,10" AutomationProperties.Name="Codex dock label"/>
                                        <TextBlock Text="Gemini" Style="{StaticResource SecondaryText}"/><TextBox x:Name="GeminiLabelField" MaxLength="18" Style="{StaticResource Field}" Margin="0,4,0,10" AutomationProperties.Name="Gemini dock label"/>
                                        <TextBlock Text="Cursor" Style="{StaticResource SecondaryText}"/><TextBox x:Name="CursorLabelField" MaxLength="18" Style="{StaticResource Field}" Margin="0,4,0,0" AutomationProperties.Name="Cursor dock label"/>
                                    </StackPanel></Expander></Border>
                                    <Border Style="{StaticResource Card}"><Expander Header="More display options"><StackPanel Margin="0,8,0,0">
                                        <CheckBox x:Name="AccountNamesBox" Content="Account name in detail cards" Style="{StaticResource Toggle}"/>
                                        <CheckBox x:Name="SleekBox" Content="Sleek proportions (slimmer dock and smaller logos)" Style="{StaticResource Toggle}"/>
                                        <CheckBox x:Name="LogoColorBox" Content="Brand colours for provider logos" Style="{StaticResource Toggle}" Checked="Preview_Changed" Unchecked="Preview_Changed"/>
                                        <CheckBox x:Name="CompactBox" Content="Compact dock (smaller rings, no labels)" Style="{StaticResource Toggle}"/>
                                        <CheckBox x:Name="DashboardBox" Content="Always show the dashboard button in the detail card" Style="{StaticResource Toggle}"/>
                                        <TextBlock Text="Compact mode hides all dock text. Expanded cards keep their own settings." Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                                    </StackPanel></Expander></Border>
                                </StackPanel></ScrollViewer>
                            </TabItem>

                            <TabItem Header="Appearance" Style="{StaticResource NavTab}">
                                <ScrollViewer Style="{StaticResource PageScroll}"><StackPanel MaxWidth="860" HorizontalAlignment="Left" Margin="6,0,0,0">
                                    <TextBlock Text="Look and feel" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="The workspace, the dock and your phone share one design: liquid glass over soft coloured light." Style="{StaticResource SecondaryText}" Margin="0,0,0,16"/>
                                    <TextBlock Text="WORKSPACE" Style="{StaticResource GroupLabel}"/>
                                    <Border Style="{StaticResource Card}"><StackPanel>
                                        <TextBlock Text="Theme" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                        <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ThemeSystem" Content="System" GroupName="Theme" Style="{StaticResource Segment}"/>
                                            <RadioButton x:Name="ThemeLight" Content="Light" GroupName="Theme" Style="{StaticResource Segment}"/>
                                            <RadioButton x:Name="ThemeDark" Content="Dark" GroupName="Theme" Style="{StaticResource Segment}"/>
                                        </StackPanel></Border>
                                        <TextBlock Text="System follows Windows' app mode. The dock keeps its own colour below." Style="{StaticResource SecondaryText}" Margin="0,10,0,8"/>
                                        <CheckBox x:Name="CometBox" Content="Comet-trail rings with time-left hairlines" Style="{StaticResource Toggle}"/>
                                        <TextBlock Text="Arcs brighten from a faint tail to their head, as on your phone. Off draws flat arcs." Style="{StaticResource SecondaryText}"/>
                                    </StackPanel></Border>
                                    <Border Style="{StaticResource Card}"><StackPanel>
                                        <TextBlock Text="Provider colours" Style="{StaticResource SectionTitle}"/>
