                                                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Ui.Muted}" TextWrapping="Wrap" FontSize="11.5"/>
                                            </StackPanel></Border>
                                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    </StackPanel></Border>
                                </StackPanel></ScrollViewer>
                            </TabItem>

                            <TabItem Header="Providers" Style="{StaticResource NavTab}">
                                <ScrollViewer Style="{StaticResource PageScroll}"><StackPanel MaxWidth="860" HorizontalAlignment="Left" Margin="6,0,0,0">
                                    <TextBlock Text="Providers &amp; accounts" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="What the dock watches. Your AI sign-ins stay where their own apps keep them; UsageNotch only reads them." Style="{StaticResource SecondaryText}" Margin="0,0,0,16"/>
