                                        <PasswordBox x:Name="OpenAiKey" Style="{StaticResource PasswordField}" Height="42" />
                                        <TextBlock Text="Monthly budget (USD)" Style="{StaticResource SecondaryText}" Margin="1,12,0,6" />
                                        <TextBox x:Name="OpenAiBudget" Style="{StaticResource Field}" Height="42" />
                                    </StackPanel></Border>
                                    <TextBlock Text="API SPEND · ANTHROPIC" Style="{StaticResource GroupLabel}"/>
                                    <Border Style="{StaticResource Card}"><StackPanel>
                                        <TextBlock Text="Admin credential" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Encrypted with Windows DPAPI for your account. Leave blank to keep the saved credential." Style="{StaticResource SecondaryText}" Margin="0,4,0,10" />
                                        <PasswordBox x:Name="AnthropicKey" Style="{StaticResource PasswordField}" Height="42" />
                                        <TextBlock Text="Monthly budget (USD)" Style="{StaticResource SecondaryText}" Margin="1,12,0,6" />
                                        <TextBox x:Name="AnthropicBudget" Style="{StaticResource Field}" Height="42" />
                                    </StackPanel></Border>
                                    <TextBlock Text="Spend comes from each vendor's official cost-reporting API. A budget turns that spend into a percentage ring." Style="{StaticResource SecondaryText}" Margin="6,0,0,0"/>
                                </StackPanel></ScrollViewer>
                            </TabItem>

                            <TabItem Header="Time" Style="{StaticResource NavTab}">
                                <ScrollViewer Style="{StaticResource PageScroll}"><StackPanel MaxWidth="860" HorizontalAlignment="Left" Margin="6,0,0,0">
                                    <TextBlock Text="Clear at a glance" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="Local time, in the format that feels natural to you." Style="{StaticResource SecondaryText}" Margin="0,0,0,16"/>
                                    <Border Style="{StaticResource Card}" Padding="10"><controls:SettingsPreview x:Name="ClockPreview" Scene="Time"/></Border>
                                    <Border Style="{StaticResource Card}"><StackPanel>
                                        <TextBlock Text="Clock format" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                        <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><RadioButton x:Name="Clock12" Content="1:45 PM" GroupName="ClockFormat" Style="{StaticResource Segment}"/><RadioButton x:Name="Clock24" Content="13:45" GroupName="ClockFormat" Style="{StaticResource Segment}"/></StackPanel></Border>
                                        <CheckBox x:Name="ClockSecondsBox" Content="Show seconds in clock times" Style="{StaticResource Toggle}" Margin="0,14,0,6"/>
                                        <TextBlock Text="Applies to reset clocks, charts and forecasts. Countdown timers keep their second-by-second precision." Style="{StaticResource SecondaryText}"/>
                                    </StackPanel></Border>
                                    <Border Style="{StaticResource Card}"><StackPanel>
                                        <TextBlock Text="Usage explorer" Style="{StaticResource SectionTitle}"/>
                                        <CheckBox x:Name="DetailedStatsBox" Content="Open chart tools and analysis by default" Style="{StaticResource Toggle}"/>
                                        <TextBlock Text="Off keeps the explorer focused on the chart and a short forecast. Expand Explore history for the overview, sessions, patterns and events." Style="{StaticResource SecondaryText}"/>
                                    </StackPanel></Border>
                                </StackPanel></ScrollViewer>
                            </TabItem>

                            <TabItem x:Name="PhoneTab" Header="Phone" Style="{StaticResource NavTab}">
                                <ScrollViewer Style="{StaticResource PageScroll}"><StackPanel MaxWidth="860" HorizontalAlignment="Left" Margin="6,0,0,0">
                                    <TextBlock Text="Your usage, on your phone" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="UsageNotch for Android shows these limits with rings, home-screen widgets, budgets and alerts. Budgets, colours, names, order and alert settings stay in sync both ways. Your AI sign-ins never leave this PC." Style="{StaticResource SecondaryText}" Margin="0,0,0,16"/>
                                    <Border Style="{StaticResource Card}"><StackPanel>
                                        <CheckBox x:Name="PhoneShareBox" Content="Share usage with paired phones" Style="{StaticResource Toggle}" Click="PhoneShare_Click"/>
                                        <TextBlock x:Name="PhoneStatus" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                                        <Button x:Name="PhoneSwitchButton" Content="Switch to built-in" Style="{StaticResource PrimaryButton}" Click="PhoneSwitch_Click" Visibility="Collapsed" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                                    </StackPanel></Border>

                                    <TextBlock Text="PAIR A PHONE" Style="{StaticResource GroupLabel}"/>
                                    <Border Style="{StaticResource Card}"><Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border x:Name="PhoneQrFrame" Background="White" CornerRadius="20" Padding="10" Width="240" Height="240" VerticalAlignment="Top">
                                            <Grid>
                                                <Image x:Name="PhoneQr" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="Pairing QR code"/>
                                                <TextBlock x:Name="PhoneQrPlaceholder" Text="Turn on sharing to show your pairing code" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="18" Foreground="#5A6474" FontSize="13"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="22,0,0,0">
                                            <TextBlock Text="Scan to pair" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,0" TextWrapping="Wrap">
                                                <Run Text="1. On Android, open UsageNotch and tap"/> <Run Text="Scan QR code" FontWeight="SemiBold"/><Run Text="."/>
                                                <LineBreak/><Run Text="2. Point the phone at this code. That's it."/>
                                                <LineBreak/><LineBreak/><Run Text="No app yet? Scan the code with the phone's camera. The page that opens lets you download it, then pair in one tap."/>
                                            </TextBlock>
                                            <TextBlock Text="Network" Style="{StaticResource SectionTitle}" Margin="0,16,0,8"/>
                                            <WrapPanel x:Name="PhoneAddresses"/>
                                            <TextBlock Text="Choose the network your phone uses, usually Wi-Fi. Virtual adapters (WSL, Hyper-V) are listed last." Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,4,0,10"/>
                                            <WrapPanel>
                                                <Button x:Name="PhoneCopyButton" Content="Copy pairing code" Style="{StaticResource SecondaryButton}" Click="PhoneCopy_Click" Margin="0,0,8,8"/>
                                                <Button x:Name="PhoneExportButton" Content="Save pairing file" Style="{StaticResource SecondaryButton}" Click="PhoneExport_Click" Margin="0,0,8,8"/>
                                                <Button Content="Get the Android app" Style="{StaticResource SecondaryButton}" Click="PhoneDownload_Click" Margin="0,0,8,8"/>
                                            </WrapPanel>
                                            <TextBlock Text="The code is a key to your usage readings. Only show or send it to your own phone." Style="{StaticResource SecondaryText}" FontSize="11"/>
                                        </StackPanel>
                                    </Grid></Border>

                                    <TextBlock Text="AWAY FROM HOME" Style="{StaticResource GroupLabel}"/>
                                    <Border Style="{StaticResource Card}"><StackPanel>
                                        <TextBlock Text="Internet sync (optional)" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="Get readings on mobile data or any Wi-Fi, and keep the latest one after this PC shuts down. Each reading is encrypted here with a key only your paired phone has, then stored in a secret gist in your own GitHub account. GitHub sees only ciphertext." Style="{StaticResource SecondaryText}" Margin="0,6,0,10"/>
                                        <StackPanel x:Name="PhoneSyncSetup">
                                            <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="Click the button, sign in to GitHub if asked, then click Generate token and the copy icon next to the new token. UsageNotch picks it up by itself, clears it from the clipboard and stores it encrypted with Windows DPAPI. The token can only read and write gists."/>
                                            <WrapPanel Margin="0,12,0,0">
                                                <Button x:Name="PhoneSyncOnButton" Content="Turn on internet sync" Style="{StaticResource PrimaryButton}" Click="PhoneSyncEasy_Click" Margin="0,0,8,8"/>
                                                <Button x:Name="PhoneSyncCancelButton" Content="Cancel" Style="{StaticResource SecondaryButton}" Click="PhoneSyncCancel_Click" Visibility="Collapsed" Margin="0,0,8,8"/>
                                            </WrapPanel>
                                            <Expander Header="Paste a token instead" Margin="0,6,0,0"><StackPanel Margin="0,8,0,0">
                                                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"><Hyperlink Click="PhoneTokenHelp_Click" Foreground="{DynamicResource Ui.Accent}">Create a GitHub token</Hyperlink><Run Text=" with the gist scope (classic) or Account permissions → Gists: Read and write (fine-grained), then paste it here."/></TextBlock>
                                                <PasswordBox x:Name="PhoneToken" Style="{StaticResource PasswordField}" Height="42" Margin="0,10,0,10"/>
                                                <Button Content="Use this token" Style="{StaticResource SecondaryButton}" Click="PhoneSyncOn_Click" HorizontalAlignment="Left"/>
                                            </StackPanel></Expander>
                                        </StackPanel>
                                        <Button x:Name="PhoneSyncOffButton" Content="Turn off internet sync" Style="{StaticResource SecondaryButton}" Click="PhoneSyncOff_Click" HorizontalAlignment="Left" Visibility="Collapsed"/>
                                        <TextBlock x:Name="PhoneSyncStatus" Style="{StaticResource SecondaryText}" Margin="0,10,0,0"/>
                                    </StackPanel></Border>

                                    <TextBlock Text="SECURITY" Style="{StaticResource GroupLabel}"/>
                                    <Border Style="{StaticResource Card}"><StackPanel>
                                        <TextBlock Text="Phones connect over HTTPS pinned to this PC's own certificate, with a random 256-bit key. Revoking disconnects every paired phone and changes the internet sync key." Style="{StaticResource SecondaryText}" Margin="0,0,0,12"/>
                                        <Button Content="Revoke all paired phones" Style="{StaticResource SecondaryButton}" Click="PhoneRevoke_Click" HorizontalAlignment="Left"/>
                                    </StackPanel></Border>
                                </StackPanel></ScrollViewer>
                            </TabItem>

                            <TabItem Header="Data" Style="{StaticResource NavTab}">
                                <ScrollViewer Style="{StaticResource PageScroll}"><StackPanel MaxWidth="860" HorizontalAlignment="Left" Margin="6,0,0,0">
                                    <TextBlock Text="Data &amp; privacy" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="Everything UsageNotch keeps stays on this PC unless you share it with your own phone." Style="{StaticResource SecondaryText}" Margin="0,0,0,16"/>
                                    <TextBlock Text="LOCAL TOKENS" Style="{StaticResource GroupLabel}"/>
                                    <Border Style="{StaticResource Card}"><StackPanel>
                                        <CheckBox x:Name="TrackTokensBox" Content="Count tokens from Claude Code and Codex transcripts" Style="{StaticResource Toggle}"/>
                                        <TextBlock Text="Reads the usage numbers, model names and project folder names from the transcripts these tools already keep on this PC. Message text is never stored or sent." Style="{StaticResource SecondaryText}" Margin="0,0,0,6"/>
                                        <CheckBox x:Name="ShareProjectsBox" Content="Show project folder names on my phone" Style="{StaticResource Toggle}"/>
                                    </StackPanel></Border>
                                    <TextBlock Text="SERVICE STATUS" Style="{StaticResource GroupLabel}"/>
                                    <Border Style="{StaticResource Card}"><StackPanel>
                                        <CheckBox x:Name="IncidentsBox" Content="Show incidents from provider status pages" Style="{StaticResource Toggle}"/>
                                        <TextBlock Text="Checks the public status pages of Claude, OpenAI and Cursor at most every five minutes. Nothing about you is sent." Style="{StaticResource SecondaryText}"/>
                                    </StackPanel></Border>
                                    <TextBlock Text="STORAGE" Style="{StaticResource GroupLabel}"/>
                                    <Border Style="{StaticResource Card}"><ContentControl x:Name="DataHost" Tag="manual"/></Border>
                                    <Border Style="{StaticResource Card}"><StackPanel>
                                        <TextBlock Text="Credits" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="Provider marks: Simple Icons (CC0) and Lobe Icons (MIT). Independent project, not affiliated with Anthropic, OpenAI, Google, Cursor or GitHub." Style="{StaticResource SecondaryText}" Margin="0,4,0,10"/>
                                        <Button Content="Icon credits" Style="{StaticResource SecondaryButton}" Click="Credits_Click" HorizontalAlignment="Left"/>
                                    </StackPanel></Border>
                                </StackPanel></ScrollViewer>
                            </TabItem>

                            <TabItem Header="Updates" Style="{StaticResource NavTab}">
                                <ScrollViewer Style="{StaticResource PageScroll}"><StackPanel MaxWidth="860" HorizontalAlignment="Left" Margin="6,0,0,0">
                                    <TextBlock Text="Stay current" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="Signed updates from GitHub Releases." Style="{StaticResource SecondaryText}" Margin="0,0,0,16"/>
                                    <Border Style="{StaticResource Card}"><StackPanel>
                                        <TextBlock Text="Secure automatic updates" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="Checks GitHub every 6 hours and downloads verified releases. Updates apply when you next launch the app, or when you choose Restart to update." Style="{StaticResource SecondaryText}" Margin="0,8,0,12"/>
                                        <CheckBox x:Name="AutoUpdateBox" Content="Automatically check and download updates" Style="{StaticResource Toggle}"/>
                                        <TextBlock x:Name="UpdateStatus" Style="{StaticResource SecondaryText}" Margin="0,14,0,14"/>
                                        <ProgressBar x:Name="UpdateProgress" Height="5" Maximum="100" Margin="0,0,0,12" Visibility="Collapsed"/>
                                        <WrapPanel>
                                            <Button Content="Check now" Style="{StaticResource SecondaryButton}" Click="CheckUpdates_Click" Margin="0,0,8,8"/>
                                            <Button x:Name="RestartUpdateButton" Content="Restart to update" Style="{StaticResource PrimaryButton}" Click="RestartUpdate_Click" IsEnabled="False" Margin="0,0,0,8"/>
                                        </WrapPanel>
                                    </StackPanel></Border>
                                    <TextBlock Text="Release metadata is signed. Downloads must match the signed SHA-256 hash. Older versions are rejected. The previous app is kept as a backup; your settings and usage history stay in place." Style="{StaticResource SecondaryText}" Margin="6,0,0,0"/>
                                </StackPanel></ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Grid>

                    <Border x:Name="FooterBar" Grid.Row="2" Style="{StaticResource Card}" Margin="22,0,22,16" Padding="18,10" Visibility="Collapsed" CornerRadius="999">
                        <Grid>
                            <TextBlock x:Name="UpdateFooter" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" MaxWidth="520" HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" MinWidth="96" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="Cancel_Click" />
                                <Button Content="Save changes" MinWidth="126" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
