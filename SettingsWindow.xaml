                                    </StackPanel></Border>
                                </StackPanel></ScrollViewer>
                            </TabItem>

                            <TabItem Header="Budgets" Style="{StaticResource NavTab}">
                                <ScrollViewer Style="{StaticResource PageScroll}"><StackPanel MaxWidth="860" HorizontalAlignment="Left" Margin="6,0,0,0">
                                    <TextBlock Text="Budgets" Style="{StaticResource PageTitle}"/>
