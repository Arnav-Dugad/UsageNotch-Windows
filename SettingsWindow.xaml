                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="Gemini uses its first two model buckets. These are coding-tool quotas, not ChatGPT or Gemini web-chat usage." Style="{StaticResource SecondaryText}" Margin="0,12,0,0"/>
                                    </StackPanel></Border>

                                    <TextBlock Text="ON THE DOCK" Style="{StaticResource GroupLabel}"/>
